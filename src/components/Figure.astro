---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro:assets";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  creditName?: string;
  creditUrl?: string;
  width?: number;
  height?: number;
}

const {
  src,
  alt,
  caption,
  creditName,
  creditUrl,
  width = 1020,
  height = 510,
} = Astro.props;

const isLocalImage = typeof src !== "string";
---

<figure>
  {
    isLocalImage ? (
      <Image src={src} alt={alt} width={width} height={height} fit="cover" />
    ) : (
      <img src={src} alt={alt} />
    )
  }
  {
    (caption || creditName) && (
      <figcaption>
        {caption}
        {creditName && (
          <span class="credit">
            Photo:{" "}
            {creditUrl ? <a href={creditUrl}>{creditName}</a> : creditName}
          </span>
        )}
      </figcaption>
    )
  }
</figure>

<style>
  figure {
    margin: 32px 0;
  }
  figure :global(img) {
    margin: 0 0 10px;
    width: 100%;
    height: auto;
    display: block;
    border-radius: 10px;
  }
  figcaption {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-soft);
    text-align: center;
  }
  .credit {
    display: block;
    margin-top: 4px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--ink-soft);
    opacity: 0.7;
  }
  .credit a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 2px;
  }
  .credit a:hover {
    color: var(--ink);
    text-decoration-color: var(--ink-soft);
  }
</style>
