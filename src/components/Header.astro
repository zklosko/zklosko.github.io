---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import { Icon } from "astro-icon/components";
import SocialLinks from "./SocialLinks.astro";
---

<header>
  <div class="header-inner">
    <div class="logo"><span class="logo-mark"></span>{SITE_TITLE}</div>
    <nav>
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/blog">Blog</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
    </nav>
    <div class="socials">
      <SocialLinks />
      <pagefind-modal-trigger class="nav-search" compact hide-shortcut
        >Search</pagefind-modal-trigger
      >
    </div>
  </div>
</header>
<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 32px;
    max-width: 980px;
    margin: 0 auto;
  }
  .logo {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 18px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .logo-mark {
    width: 28px;
    height: 28px;
    border-radius: 7px;
    background: linear-gradient(
      135deg,
      var(--amber),
      var(--teal) 55%,
      var(--violet)
    );
    flex-shrink: 0;
  }
  nav {
    display: flex;
    gap: 28px;
  }
  .socials {
    display: flex;
    gap: 14px;
  }
  .socials a {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    color: var(--ink-soft);
    transition:
      background 0.15s,
      color 0.15s;
  }
  .socials a:hover {
    background: var(--amber-tint);
    color: var(--ink);
  }
  .socials svg {
    width: 32px;
    height: 32px;
  }
  .nav-search {
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-soft);
    background: none;
    border: none;
    padding: 0 0 4px;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .nav-search:hover {
    --pf-text: var(--ink);
  }

  @media (max-width: 720px) {
    .socials {
      display: none;
    }
  }

  @media (prefers-color-scheme: dark) {
    header {
      background: var(--bg);
    }
  }
</style>
