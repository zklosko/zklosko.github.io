---
import { Icon } from "astro-icon/components";
import SocialLinks from "./SocialLinks.astro";
const today = new Date();
---

<footer>
  &copy; {today.getFullYear()} Zachary Klosko. All rights reserved.
  <div class="socials">
    <SocialLinks />
  </div>
</footer>
<style>
  footer {
    border-top: 1px solid var(--line);
    padding: 32px 0 40px;
    color: var(--ink-soft);
    font-size: 13px;
    text-align: center;
  }
  .socials {
    display: flex;
    justify-content: center;
    gap: 1em;
    margin-top: 14px;
  }
</style>
