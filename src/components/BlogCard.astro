---
import { Image } from "astro:assets";
import FormattedDate from "./FormattedDate.astro";
import TagList from "./TagList.astro";

interface Props {
  id: string;
  title: string;
  description: string;
  pubDate?: Date;
  heroImage?: any;
  postType: "prose" | "case-study" | "guide" | "tutorial";
  tags?: string[];
}

const { id, title, description, pubDate, heroImage, postType, tags } =
  Astro.props;

const typeColor: Record<string, string> = {
  prose: "rose",
  "case-study": "teal",
  guide: "amber",
  tutorial: "violet",
};

const typeLabel: Record<string, string> = {
  prose: "Prose",
  "case-study": "Case Study",
  guide: "Guide",
  tutorial: "Tutorial",
};

const colorClass = typeColor[postType] ?? "rose";
---

<article class="card">
  <a href={`/blog/${id}/`} class="card-link">
    {
      heroImage && (
        <div class="thumb">
          <Image
            src={heroImage}
            alt={title}
            width={720}
            height={360}
            fit="cover"
          />
        </div>
      )
    }
    <div class="card-body">
      <a href={`/blog/${postType}/`} class={`type-badge ${colorClass}`}>
        {typeLabel[postType] ?? postType}
      </a>
      <h3>{title}</h3>
      <p class="desc">{description}</p>
      {
        pubDate && (
          <p class="date">
            <FormattedDate date={pubDate} />
          </p>
        )
      }
    </div>
  </a>
  <div class="card-tags">
    <TagList tags={tags} />
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
  }
  .card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .thumb :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    display: block;
    border-radius: 12px;
    margin-bottom: 12px;
  }
  .type-badge {
    display: inline-block;
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 6px;
    text-decoration: none;
    margin-bottom: 8px;
  }
  .type-badge.rose {
    background: var(--rose-tint);
    color: var(--rose);
  }
  .type-badge.teal {
    background: var(--teal-tint);
    color: var(--teal);
  }
  .type-badge.amber {
    background: var(--amber-tint);
    color: var(--amber);
  }
  .type-badge.violet {
    background: var(--violet-tint);
    color: var(--violet);
  }
  h3 {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 600;
    font-size: 18px;
    margin: 0 0 6px;
    color: var(--ink);
  }
  .desc {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0 0 8px;
  }
  .date {
    font-size: 13px;
    color: var(--ink-soft);
    margin: 0 0 10px;
  }
  .card-tags {
    margin-top: auto;
  }
</style>
