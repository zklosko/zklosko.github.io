---
import { undefined } from "astro:schema";

interface Props {
  title: string;
  description: string;
  url: string;
  tags?: string[];
  featured?: boolean;
}

const {
  title,
  description,
  url,
  tags = [],
  featured = false,
}: Props = Astro.props;
---

<article class:list={{ card: true, featured }}>
  <h3>
    <a href={url}>{title}</a>
  </h3>

  <p>{description}</p>

  {
    tags.length > 0 && (
      <ul class="tags">
        {tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .card {
    height: 100%;
    padding: 1.5rem;
    border: 1px solid rgb(var(--grey-light));
    border-radius: 12px;
    background: white;
    /* box-shadow: 0 4px 12px rgb(0 0 0 / 5%); */
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgb(0 0 0 / 10%);
    /* border-color: rgb(var(--gray)); */
  }
  .card.featured {
    grid-column: span 2;
  }

  a {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  h3 {
    margin-bottom: 0.5rem;
  }

  h3 a {
    color: inherit;
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--accent);
  }

  p {
    margin: 0 0 1rem;
    color: rgb(var(--gray));
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tags li {
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: rgb(var(--gray-light));
    font-size: 0.85rem;
    font-weight: 500;
  }

  @media (prefers-color-scheme: dark) {
    .card {
      background: #1d1d1d;
      border-color: #333;
      box-shadow: none;
    }

    .tags li {
      background: #333;
    }
  }
</style>
