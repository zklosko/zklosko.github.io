---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import FormattedDate from "../components/FormattedDate.astro";
import ChannelStrip from "../components/ChannelStrip.astro";
import { getCollection } from "astro:content";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import Hero from "../components/Hero.astro";

const projects = await getCollection("projects");

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPost = posts[0];
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <Hero />

  {
    latestPost && (
      <a href={`/blog/${latestPost.id}/`} class="latest-post">
        <span class="eyebrow-small">Latest post</span>
        <h2>{latestPost.data.title}</h2>
        <p class="desc">{latestPost.data.description}</p>
        <p class="date">
          <FormattedDate date={latestPost.data.pubDate} />
        </p>
      </a>
    )
  }

  <ChannelStrip />

  <div class="section-head">
    <h2 class="display">Projects</h2>
  </div>

  <div class="grid">
    {
      projects.map((project) => (
        <ProjectCard
          title={project.data.title}
          category={project.data.category}
          description={project.data.description}
          url={project.data.url}
          github={project.data.github}
          tags={project.data.tags}
          featured={project.data.featured}
        />
      ))
    }
  </div>
</BaseLayout>

<style>
  .latest-post {
    display: block;
    padding: 24px 26px;
    margin: 12px 0 60px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 3px solid var(--teal);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }
  .latest-post:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(20, 20, 20, 0.08);
  }
  .eyebrow-small {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--teal);
  }
  .latest-post h2 {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 24px;
    margin: 8px 0 8px;
    color: var(--ink);
  }
  .latest-post .desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0 0 10px;
  }
  .latest-post .date {
    font-size: 13px;
    color: var(--ink-soft);
    margin: 0;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 28px;
  }
  h2.display {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 30px;
    margin: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
    padding-bottom: 90px;
  }
  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
