---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const projects = await getCollection("projects");
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <h1>Hi, I'm Zack!</h1>
      <p class="tagline">
        Software developer and production engineer building tools for live
        events.
      </p>
      <p>
        I work at Hope Church in Richmond, VA, making services hum and creating
        a special place for students to belong and be themselves. Software
        development, building automation, and 3D printing somehow fall into
        "other duties as assigned".
      </p>

      <h2>Projects</h2>

      <div class="projects">
        {
          projects.map((project) => (
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              url={project.data.url}
              tags={project.data.tags}
              featured={project.data.featured}
            />
          ))
        }
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  h1 {
    font-size: clamp(3rem, 8vw, 4.5rem);
    letter-spacing: -0.04em;
    margin-bottom: 0;
  }
  .tagline {
    margin-top: 0.75rem;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 500;
    line-height: 1.4;
    color: rgb(var(--gray));
    max-width: 45ch;
  }
  .projects {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 2rem;
    row-gap: 3.5rem;
    margin-top: 2rem;
  }
  @media (max-width: 720px) {
    .projects {
      grid-template-columns: 1fr;
    }
  }
</style>
