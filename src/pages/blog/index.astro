---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import BlogCard from "../../components/BlogCard.astro";

const posts = await getCollection("blog");
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="blog-index">
    <h1 class="display">Posts</h1>
    <div class="posts">
      {posts.map((post) => <BlogCard id={post.id} {...post.data} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .posts article > :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    display: block;
  }
  h1.display {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 40px;
    margin: 0 0 32px;
  }
  .blog-index {
    max-width: 980px;
    margin: 0 auto;
    padding: 76px 32px 90px;
  }
  .desc {
    margin: 0 0 0.5rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .date {
    margin: 0;
    font-size: 13px;
    color: rgb(var(--gray));
  }
  .posts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 2rem;
    row-gap: 3rem;
  }
  .posts a {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .posts article img {
    display: block;
    width: 100%;
    border-radius: 12px;
    margin-bottom: 0.75rem;
  }
  .posts h3 {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 600;
    margin: 0 0 0.4rem;
    color: var(--ink);
  }
  @media (max-width: 720px) {
    .posts {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-color-scheme: dark) {
    .featured img,
    .posts article img {
      box-shadow: none;
    }
  }
</style>
