---
import Layout from "../layouts/Page.astro";
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";
---

<PagefindConfig />

<Layout title="Search" description="Search this website">
  <div class="search"></div>
  <pagefind-input autofocus="true"></pagefind-input>
  <pagefind-summary></pagefind-summary>
  <pagefind-results max-results="10"></pagefind-results>
</Layout>

<style>
  .search {
    min-height: 3vh;
  }

  pagefind-input {
    display: block;
    margin-bottom: 2rem;
  }

  pagefind-summary {
    display: block;
    margin-bottom: 1rem;
    color: rgb(var(--gray));
  }
</style>
